{
  "name": "gha-failure-analyzer",
  "version": "1.0.0",
  "description": "CLI for analyzing failed GitHub Actions workflow runs using OpenCode SDK",
  "type": "module",
  "main": "./dist-cli/index.js",
  "types": "./dist-cli/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist-cli/index.js",
      "types": "./dist-cli/index.d.ts"
    }
  },
  "bin": {
    "gha-failure-analyzer": "./dist-cli/main.js"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc",
    "build:action": "ncc build src/action/index.ts -o dist --source-map --license licenses.txt",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "clean": "rimraf dist dist-cli coverage"
  },
  "keywords": [
    "github-actions",
    "workflow",
    "analyzer",
    "cli",
    "opencode"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@octokit/rest": "22.0.1",
    "@opencode-ai/plugin": "1.17.9",
    "@opencode-ai/sdk": "1.17.9",
    "@slack/web-api": "7.17.0",
    "commander": "15.0.0",
    "dotenv": "17.4.2",
    "marked": "^18.0.5",
    "marked-terminal": "7.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/marked-terminal": "6.1.1",
    "@types/node": "26.0.0",
    "@vercel/ncc": "0.44.0",
    "@vitest/coverage-v8": "4.1.9",
    "@vitest/ui": "4.1.9",
    "eslint": "10.5.0",
    "globals": "17.7.0",
    "rimraf": "6.1.3",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.0",
    "vitest": "4.1.9"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
